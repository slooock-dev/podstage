# podstage runtime — self-contained streaming sandbox image.
#
# Design decision (OSS goal): bake ALL software into the image so it is
# host-independent — it carries its whole software stack. Only user DATA (the
# Steam HOME: login, saves, downloaded games + Proton) is a runtime volume — a
# distributable image cannot contain an account or a game library.
#
# The NVIDIA userspace is injected at RUN time via CDI
# (`--device nvidia.com/gpu=all`) to match the host driver version.
#
#   labwc (WLR_BACKENDS=headless)  ← Sunshine captures this via wlr (NVENC/VAAPI)
#     └─ gamescope (--backend wayland, nested)   [desktop mode: Steam directly]
#          └─ steam -gamepadui  → game
#
# gamescope's Vulkan renderer inits in-container on the host driver, identical
# to a host run (where Wolf's smithay-EGL fails, GOW #124).

# Pinned digest: build cache + audit anchor.
FROM docker.io/library/archlinux:latest@sha256:fe6972d4dc1f660c0c10f4c41b2de8986bab89e7e2955378f8beadb8ebcd7433

# --- multilib (Steam is 32-bit) + base refresh -----------------------------
RUN printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf && \
    pacman -Sy --noconfirm archlinux-keyring && \
    pacman -Su --noconfirm

# --- compositor / renderer / streaming stack -------------------------------
# 64-bit + 32-bit Vulkan loaders + mesa (llvmpipe fallback + libgbm). NVIDIA
# ICD/libs come from CDI at runtime. steam pulls its own lib32 GL/Vulkan deps.
RUN pacman -S --noconfirm --needed \
        gamescope \
        labwc \
        seatd \
        vulkan-icd-loader lib32-vulkan-icd-loader \
        vulkan-tools \
        vulkan-mesa-layers lib32-vulkan-mesa-layers \
        vulkan-swrast lib32-vulkan-swrast \
        mesa lib32-mesa \
        libglvnd lib32-libglvnd \
        pipewire pipewire-pulse wireplumber pipewire-alsa \
        steam \
        wlr-randr \
        bash coreutils procps-ng curl && \
    pacman -Scc --noconfirm

# --- Sunshine (native Arch package from the official release) --------------
# The AppImage bundles its own libva, which can't load the image's Mesa VAAPI
# driver (Debian dri path + too-old libva ABI) — VAAPI init fails and Sunshine
# silently falls back to software x264. The release's Arch package links
# against the image's own libva/Mesa instead, so the VAAPI path just works.
# Version- AND content-pinned: the sha256 comes from the GitHub release asset
# digest, so a tampered or corrupted download fails the build instead of
# landing in the image. When bumping SUNSHINE_VERSION, take the new hash from
#   https://api.github.com/repos/LizardByte/Sunshine/releases/tags/<tag>
# (assets[].digest).
ARG SUNSHINE_VERSION=v2026.516.143833
ARG SUNSHINE_SHA256=676539cfb079f81f38e7001b85d72c39cd5bf25abe0956bab4577cb25afc5299
ARG SUNSHINE_URL=https://github.com/LizardByte/Sunshine/releases/download/${SUNSHINE_VERSION}/sunshine-${SUNSHINE_VERSION#v}-1-x86_64.pkg.tar.zst
RUN curl -fL "$SUNSHINE_URL" -o /tmp/sunshine.pkg.tar.zst && \
    echo "${SUNSHINE_SHA256}  /tmp/sunshine.pkg.tar.zst" | sha256sum -c - && \
    pacman -U --noconfirm /tmp/sunshine.pkg.tar.zst && \
    rm -f /tmp/sunshine.pkg.tar.zst && \
    pacman -Scc --noconfirm && \
    printf '%s\n' "$SUNSHINE_VERSION" > /opt/sunshine.version

# A machine-id lets wireplumber/dbus optional components load quietly.
RUN systemd-machine-id-setup 2>/dev/null || \
    tr -dc 'a-f0-9' < /dev/urandom | head -c 32 > /etc/machine-id

# Steam (steam-runtime-launcher-service) requires a session D-Bus; without one it
# crash-loops and never reaches Big Picture. Ship the dbus daemon; the entrypoint
# starts a private session bus. (Separate layer to keep the big package layer cached.)
RUN pacman -Sy --noconfirm dbus && pacman -Scc --noconfirm

# Capture + AMD/Intel userspace (separate layer, keeps the big layer cached):
#  * wf-recorder + ffmpeg — thumbnail loop (entrypoint) and headless frame
#    verification.
#  * RADV Vulkan ICDs + Mesa VAAPI drivers — the AMD GPU path (host NVIDIA
#    userspace comes via CDI instead; Mesa has no host-version coupling).
#  * ANV Vulkan ICDs + iHD VAAPI driver (Broadwell+): the Intel GPU path.
RUN pacman -Sy --noconfirm --needed \
        wf-recorder ffmpeg \
        vulkan-radeon lib32-vulkan-radeon \
        vulkan-intel lib32-vulkan-intel intel-media-driver \
        libva-mesa-driver lib32-libva-mesa-driver libva-utils \
        adwaita-cursors && \
    pacman -Scc --noconfirm

# labwc session config: undecorated main windows, no focus-follows-mouse.
COPY labwc-rc.xml /etc/xdg/labwc/rc.xml

# Seat shim: the compositor must enumerate the STREAMING seat ("seat9" —
# where the host udev rule puts Sunshine's virtual devices) instead of
# seatd's hardcoded "seat0", or it grabs the host desktop's real
# keyboard/mouse (input leak in both directions). Also fakes the udev
# hotplug monitor (inotify + eventfd on a pthread) because the kernel
# delivers no uevents into the rootless user namespace, blanks the outer
# cursor (PS_SHOW_CURSOR) and pins flat pointer accel (PS_POINTER_ACCEL) —
# all via interposed wlroots symbols, so it works for any wlroots
# compositor. LD_PRELOAD; the entrypoint loads it for labwc only.
#
# Keeper: a silent, persistent uinput pointer so the seat's POINTER
# capability never drops while Sunshine's virtual devices come and go —
# see keeper.c for the gamescope input-thread bug this works around.
COPY seat-shim.c keeper.c /tmp/
RUN pacman -S --noconfirm --needed gcc && \
    gcc -shared -fPIC -O2 -pthread -o /usr/local/lib/podstage-seat-shim.so /tmp/seat-shim.c && \
    gcc -O2 -Wall -Wextra -Werror -o /usr/local/bin/podstage-keeper /tmp/keeper.c && \
    rm /tmp/seat-shim.c /tmp/keeper.c && \
    pacman -Rns --noconfirm gcc && pacman -Scc --noconfirm

# Two small helpers that talk to the running gamescope, built in one layer:
#
#  * perf probe — a wayland client that asks gamescope for the presented
#    frametime of the focused app (gamescope_control v6 / PERF_QUERY) and drops
#    the fps where the host GUI reads it. Compositor-side, so the numbers are
#    identical on NVIDIA/AMD/Intel, unlike encoder counters. The protocol XML is
#    vendored from gamescope (MIT); wayland-scanner ships with the already
#    installed wayland package.
#  * focus nudge — an X client that re-focuses Steam's window whenever gamescope
#    hands the focus back to it, which heals Big Picture's gamepad navigation
#    after a game exits (see focus-nudge.c for the diagnosis).
COPY perf-probe.c gamescope-control.xml focus-nudge.c /tmp/build/
RUN pacman -S --noconfirm --needed gcc && \
    cd /tmp/build && \
    wayland-scanner client-header gamescope-control.xml \
        gamescope-control-client-protocol.h && \
    wayland-scanner private-code gamescope-control.xml \
        gamescope-control-protocol.c && \
    gcc -O2 -Wall -Wextra -Werror -o /usr/local/bin/podstage-perf-probe \
        perf-probe.c gamescope-control-protocol.c -I. -lwayland-client && \
    gcc -O2 -Wall -Wextra -Werror -o /usr/local/bin/podstage-focus-nudge \
        focus-nudge.c -lX11 && \
    cd / && rm -rf /tmp/build && \
    pacman -Rns --noconfirm gcc && pacman -Scc --noconfirm

# Live-session diagnosis toolbox (Deck input chain, window geometry):
# X11 pointer/window inspection inside a running session.
RUN pacman -Sy --noconfirm --needed xdotool xorg-xwininfo xorg-xprop && \
    pacman -Scc --noconfirm

# Patched wlroots for the headless output. Three frame-pacing defects in
# 0.20.2, all silent (see wlroots-headless-timing.patch): the frame timer
# truncates the period to whole milliseconds (60 Hz runs as 62.5 and beats
# against the 60 fps encoder); the present event reports refresh=0, which
# gamescope nested reads as a VRR display, and once Steam enables
# adaptive-sync gamescope stops pacing the app entirely (games render
# uncapped against a 60 fps stream); and presentation feedback is stamped
# with dispatch time instead of the frame tick, whose jitter walks
# gamescope's re-based frame clock off its period (~80 fps at -r 60). Built
# from the pinned release tarball with the Arch feature set and installed
# over the packaged library. The ldd check fails the build if labwc ever
# links a different wlroots major, where the override would silently stop
# applying.
ARG WLROOTS_VERSION=0.20.2
ARG WLROOTS_SHA256=972c7ac44b17828f4702bfae7cd8347346a3fb5b2c1076cfa2c3fcedac5ec343
COPY wlroots-headless-timing.patch /tmp/
RUN pacman -S --noconfirm --needed patch meson ninja gcc pkgconf glslang \
        vulkan-headers wayland-protocols xorgproto && \
    curl -fL "https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/${WLROOTS_VERSION}/wlroots-${WLROOTS_VERSION}.tar.gz" \
        -o /tmp/wlroots.tar.gz && \
    echo "${WLROOTS_SHA256}  /tmp/wlroots.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/wlroots.tar.gz -C /tmp && \
    cd "/tmp/wlroots-${WLROOTS_VERSION}" && \
    patch -p1 < /tmp/wlroots-headless-timing.patch && \
    meson setup build --prefix=/usr --buildtype=release -Dexamples=false \
        -Dxwayland=enabled -Drenderers=gles2,vulkan -Dbackends=drm,libinput,x11 \
        -Dallocators=gbm,udmabuf -Dsession=enabled -Dcolor-management=enabled \
        -Dlibliftoff=enabled -Dxcb-errors=enabled && \
    ninja -C build && \
    ninja -C build install && \
    ldd /usr/bin/labwc | grep -q "libwlroots-0.20.so" && \
    cd / && rm -rf /tmp/wlroots-${WLROOTS_VERSION} /tmp/wlroots.tar.gz \
        /tmp/wlroots-headless-timing.patch && \
    pacman -Rns --noconfirm patch meson ninja gcc pkgconf && \
    pacman -Scc --noconfirm

# Gamepad reconnect (experimental feature): input-mirror keeps the tmpfs
# /dev/input populated with symlinks onto /dev/input-real; pad-bounce
# removes and restores the gamepads' symlinks on demand (`podman exec`) to
# fake an unplug/replug. Last layer, so the wlroots build stays cached.
COPY input-mirror.c pad-bounce.c /tmp/
RUN pacman -S --noconfirm --needed gcc && \
    gcc -O2 -Wall -Wextra -Werror -o /usr/local/bin/podstage-input-mirror /tmp/input-mirror.c && \
    gcc -O2 -Wall -Wextra -Werror -o /usr/local/bin/podstage-pad-bounce /tmp/pad-bounce.c && \
    rm /tmp/input-mirror.c /tmp/pad-bounce.c && \
    pacman -Rns --noconfirm gcc && pacman -Scc --noconfirm

# --- unprivileged runtime user ---------------------------------------------
RUN useradd -u 1000 -m -s /bin/bash player

COPY entrypoint.sh /usr/local/bin/podstage-entrypoint
COPY runner.sh /usr/local/bin/podstage-runner
COPY resize.sh /usr/local/bin/podstage-resize
RUN chmod +x /usr/local/bin/podstage-entrypoint /usr/local/bin/podstage-runner \
        /usr/local/bin/podstage-resize

# Streaming ports (Moonlight): TCP 47984/47989/48010, UDP 47998-48000/48100/48200
EXPOSE 47984/tcp 47989/tcp 48010/tcp 47998/udp 47999/udp 48000/udp 48100/udp 48200/udp

USER player
ENV HOME=/home/player \
    XDG_RUNTIME_DIR=/run/user/1000 \
    WLR_BACKENDS=headless \
    WLR_NO_HARDWARE_CURSORS=1 \
    WLR_RENDERER_ALLOW_SOFTWARE=1 \
    PS_RESOLUTION=1280x800@60

ENTRYPOINT ["/usr/local/bin/podstage-entrypoint"]

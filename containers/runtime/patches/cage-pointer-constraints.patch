+/* A pointer device alone stays invisible: Sunshine creates virtual mice for
+ * every stream, gamepad-only clients included, and every stream start nudges
+ * the relative mouse (measured: REL +1,+1 then -1,-1, twice). Only a
+ * deliberate act (net relative displacement >= 3 px, a button press, or a
+ * scroll) activates capability, cursor image and focus. Absolute motion
+ * alone stays inert: it is indistinguishable from a position sync. */
+static void
+activate_pointer(struct cg_seat *seat, uint32_t time_msec)
+{
+	if (seat->pointer_active) {
+		return;
+	}
+	seat->pointer_active = true;
+	update_capabilities(seat);
+	cursor_show(seat);
+	process_cursor_motion(seat, time_msec, 0, 0, 0, 0);
+}
+
+static int
+handle_cursor_hide_timeout(void *data)
+{
+	struct cg_seat *seat = data;
+
+	seat->cursor_visible = false;
+	wlr_cursor_unset_image(seat->cursor);
+	return 0;
+}
+
+/* A parked idle cursor annoys gamepad streams; show it for CURSOR_HIDE_MS
+ * after each use, like the SteamOS session does. */
+static void
+cursor_show(struct cg_seat *seat)
+{
+	if (!seat->cursor_visible) {
+		seat->cursor_visible = true;
+		wlr_cursor_set_xcursor(seat->cursor, seat->xcursor_manager, DEFAULT_XCURSOR);
+	}
+	if (seat->cursor_hide_timer) {
+		wl_event_source_timer_update(seat->cursor_hide_timer, CURSOR_HIDE_MS);
+	}
+}
+
+/* Pointer constraints: a locked pointer freezes the cursor; clients (games
+ * via Xwayland, nested gamescope) then track motion exclusively through the
+ * relative-pointer events process_cursor_motion() already sends. Confined
+ * constraints keep normal movement: the kiosk view covers the whole output,
+ * so the region is effectively the screen. */
+static bool
+pointer_is_locked(struct cg_seat *seat)
+{
+	return seat->active_constraint != NULL &&
+	       seat->active_constraint->type == WLR_POINTER_CONSTRAINT_V1_LOCKED;
+}
+
+static void
+handle_constraint_destroy(struct wl_listener *listener, void *data)
+{
+	struct cg_seat *seat = wl_container_of(listener, seat, constraint_destroy);
+	struct wlr_pointer_constraint_v1 *constraint = data;
+
+	if (seat->active_constraint == constraint) {
+		seat->active_constraint = NULL;
+	}
+	wl_list_remove(&seat->constraint_destroy.link);
+	wl_list_init(&seat->constraint_destroy.link);
+}
+
+void
+handle_pointer_constraint(struct wl_listener *listener, void *data)
+{
+	struct cg_server *server = wl_container_of(listener, server, new_constraint);
+	struct cg_seat *seat = server->seat;
+	struct wlr_pointer_constraint_v1 *constraint = data;
+
+	/* Kiosk: one client owns the output; activate immediately, replacing
+	 * any previous constraint. */
+	if (seat->active_constraint != NULL) {
+		if (seat->active_constraint == constraint) {
+			return;
+		}
+		wlr_pointer_constraint_v1_send_deactivated(seat->active_constraint);
+		wl_list_remove(&seat->constraint_destroy.link);
+	}
+	seat->active_constraint = constraint;
+	seat->constraint_destroy.notify = handle_constraint_destroy;
+	wl_signal_add(&constraint->events.destroy, &seat->constraint_destroy);
+	wlr_pointer_constraint_v1_send_activated(constraint);
+}

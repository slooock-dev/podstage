# podstage moonshine backend: the alternative to labwc + gamescope + Sunshine.
#
# moonshine (https://github.com/hgaiser/moonshine) is a Rust GameStream server
# that brings its own headless Wayland compositor (smithay) and encodes with
# Vulkan Video instead of NVENC/VAAPI. It collapses compositor, capture and
# streaming server into one process, so this image needs no labwc, no seatd,
# no seat-shim and no keeper. See containers/moonshine/README.md.
#
# Derived from the runtime image on purpose: same base, same glibc, same Mesa,
# same CDI NVIDIA injection, same rootless `player` user, and Steam, gamescope
# and podstage-focus-nudge/podstage-perf-probe come along unchanged.
#
# Build:  podstage runtime build --backend moonshine
#         (podman build -t podstage-moonshine:latest containers/moonshine/)

FROM localhost/podstage-runtime:latest

USER root

# Full upgrade first: the Rust toolchain and the moonshine build pull in fresh
# libs; a plain -Sy install on the pinned base db would partial-upgrade.
#
# Build deps (moonshine README + what the crate graph actually needs):
#   rust/clang/cmake/make/git     the workspace, aws-lc-rs, rusqlite(bundled),
#                                   inputtino-sys drives cmake with "Unix Makefiles"
#   libc++, libevdev              inputtino (C++, built by its build script)
#   opus, libxkbcommon, wayland   opus-sys, smithay
#   nasm, perl                    aws-lc-rs assembly paths
# Runtime deps the base image does not already carry:
#   xorg-xwayland                 moonshine's compositor spawns its own XWayland
#   python-dbus, python-gobject   the systemd1 stub (see systemd1-stub.py)
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm --needed \
        rust clang cmake make git pkgconf \
        libc++ libevdev opus libxkbcommon wayland \
        nasm perl \
        xorg-xwayland \
        python-dbus python-gobject && \
    pacman -Scc --noconfirm

# Build moonshine from source. The crate graph pulls three git dependencies
# (ash, inputtino, pixelforge) that moonshine's Cargo.lock rev-pins, so
# --locked makes the build reproducible.
#
# Everything in one layer: the release target dir is >5 GB and only the
# artifacts are worth keeping.
#
# Pinned to a commit, not to the v0.13.5 release: that release's CLI is just
# `moonshine <config>`, while this commit adds the `healthcheck` subcommand and
# `--no-health-check`. `--no-health-check` is what the pipeline mode needs (the
# full check aborts on the missing logind); the `healthcheck` subcommand is a
# manual diagnostic via PS_MODE=healthcheck, reporting render node, EGL, Vulkan
# codecs, DMA-BUF, XWayland, D-Bus, XDG_RUNTIME_DIR, ports, uinput, uhid and
# the WSI layer. `podstage doctor` does not use it: it answers the GPU question
# with vulkaninfo against the runtime image, which needs no moonshine image
# built yet (core/doctor.py).
#
# moonshine-bench drives the compositor and encode pipeline WITHOUT a Moonlight
# client, the only way to get encode numbers out of a headless machine, and
# the instrument behind the throughput table in the README.
ARG MOONSHINE_VERSION=3f8e17c43b599545992915c56a133108333c2b89
# CARGO_HOME stays inside the RUN rather than an ENV: an ENV would survive into
# the final image, and there is no way to unset one afterwards (setting it
# empty leaves an empty value behind, which is worse than not having it).
RUN git init /tmp/moonshine && \
    cd /tmp/moonshine && \
    git remote add origin https://github.com/hgaiser/moonshine.git && \
    git fetch --depth 1 origin "$MOONSHINE_VERSION" && \
    git checkout FETCH_HEAD && \
    CARGO_HOME=/tmp/cargo cargo build --release --locked --workspace && \
    install -Dm755 target/release/moonshine /usr/local/bin/moonshine && \
    install -Dm755 target/release/moonshine-bench /usr/local/bin/moonshine-bench && \
    install -Dm755 target/release/libmoonshine_wsi.so \
        /usr/lib/moonshine/vulkan-layers/libmoonshine_wsi.so && \
    install -Dm644 dist/VkLayer_moonshine_wsi.json \
        /usr/share/vulkan/implicit_layer.d/VkLayer_moonshine_wsi.json && \
    install -Dm644 dist/60-moonshine.rules /opt/moonshine/60-moonshine.rules && \
    printf '%s\n' "$MOONSHINE_VERSION" > /opt/moonshine/version && \
    cd / && rm -rf /tmp/moonshine /tmp/cargo

# The stub systemd1 service, plus the entrypoint that replaces the runtime
# image's one (no labwc, no seatd, no Sunshine: moonshine is all of them).
COPY systemd1-stub.py /usr/local/bin/podstage-systemd1-stub
COPY entrypoint.sh /usr/local/bin/podstage-moonshine-entrypoint
COPY app.sh /usr/local/bin/podstage-moonshine-app
RUN chmod 755 /usr/local/bin/podstage-systemd1-stub \
        /usr/local/bin/podstage-moonshine-entrypoint \
        /usr/local/bin/podstage-moonshine-app

USER player

ENTRYPOINT ["/usr/local/bin/podstage-moonshine-entrypoint"]
